<div><label for="first-name">Nama depan contoh</label><input id="first-name" name="first_name" maxlength="80" autocomplete="given-name" required value="<c:out value='${values.first_name}'/>"></div>
<div><label for="last-name">Nama belakang contoh</label><input id="last-name" name="last_name" maxlength="80" autocomplete="family-name" required value="<c:out value='${values.last_name}'/>"></div>
<div><label for="email">Email contoh</label><input id="email" name="email" type="email" maxlength="160" autocomplete="email" required value="<c:out value='${values.email}'/>"></div>
<div><label for="birth-date">Tanggal lahir contoh</label><input id="birth-date" name="birth_date" type="date" min="1900-01-01" required value="<c:out value='${values.birth_date}'/>"></div>
<div><label for="gender">Keterangan gender</label><select id="gender" name="gender"><option ${values.gender == 'Tidak dinyatakan' ? 'selected' : ''}>Tidak dinyatakan</option><option ${values.gender == 'Perempuan' ? 'selected' : ''}>Perempuan</option><option ${values.gender == 'Laki-laki' ? 'selected' : ''}>Laki-laki</option></select></div>
<div><label for="phone">Telepon contoh</label><input id="phone" name="phone" type="tel" maxlength="30" autocomplete="tel" required value="<c:out value='${values.phone}'/>"></div>
<div class="full"><label for="address">Alamat contoh</label><textarea id="address" name="address" maxlength="400" autocomplete="street-address" required><c:out value="${values.address}"/></textarea></div>
